# AI Видео — что нужно nginx.
#
# Папку можно назвать как угодно (ai-premiere, video, …) и переименовывать когда угодно:
# все пути внутри неё относительные, а правила ниже не привязаны к имени папки.
# Приложение целиком берётся из этой папки: интернет и сторонние сайты не нужны.
#
# Вставьте эти блоки внутрь вашего server { ... }. Если такие блоки уже добавлены для другого
# приложения AI (AI Фото, AI Звук…) — второй раз не нужно: правила общие для всех папок с
# api/assistant.php и api/files.php. Только поднимите в блоке api/files.php client_max_body_size и
# таймауты до чисел ниже: видео больше остальных файлов.
#
# Обычной раздачи статики (включая include mime.types; в блоке http — он есть в стандартном
# nginx.conf) достаточно, чтобы редактор открылся. Две настройки ниже нужны помощнику.

# 1. ОБЯЗАТЕЛЬНО для помощника: он отправляет снимок экрана (больше стандартного 1 МБ),
#    а модель думает дольше стандартных 60 секунд.
location ~ /api/assistant\.php$ {
    client_max_body_size 20m;
    fastcgi_read_timeout 200s;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_pass php:9000;   # ← как в вашем общем блоке PHP
}

# 2. ОБЯЗАТЕЛЬНО для «Моих проектов»: туда загружаются видео, а они большие. client_max_body_size должен быть
#    не меньше AI_PREMIERE_MAX_MB (по умолчанию 1024 МБ), а в PHP — post_max_size и upload_max_filesize не меньше
#    того же (например, 1100M), max_execution_time и max_input_time — 600. Загрузка гигабайта идёт минуты.
location ~ /api/files\.php$ {
    client_max_body_size 1100m;
    client_body_timeout 600s;
    fastcgi_read_timeout 600s;
    fastcgi_send_timeout 600s;
    fastcgi_request_buffering off;   # тело запроса — сразу в PHP, без временной копии у nginx
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    fastcgi_pass php:9000;   # ← как в вашем общем блоке PHP
}

# Для .wasm нужен тип application/wasm (в стандартном mime.types он есть); части приложения (app/*.part-*)
# отдаются как есть.

# 3. Внутренние файлы помощника не нужны снаружи.
location ~ /api/(settings|tools)\.php$ {
    deny all;
}

# 4. Где лежат файлы пользователей. По умолчанию — /app/storage/ai-premiere (рядом с корнем сайта,
#    снаружи его не видно; папка создаётся сама). Если PHP не может туда писать, файлы ложатся в ai-premiere-data рядом
#    с папкой приложения — тогда закройте её (имена файлов там случайные, но лучше закрыть):
location ~ /ai-premiere-data/ {
    deny all;
}
